{{- if eq .chezmoi.os "linux" -}}
[Unit]
Description=dotdash — local dotfiles dashboard (127.0.0.1:7842)
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mise exec -- node {{ joinPath (env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local/share")) "dotdash/app/server.js" | replace "%" "%%" | replace "$" "$$" | quote }}
Environment=HOSTNAME=127.0.0.1
Environment=PORT=7842
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
{{- else -}}
{{- /* non-Linux: no output — excluded via template guard */ -}}
{{- end -}}
