{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./AGENTS.md",
    "./docs/troubleshooting.md"
  ],
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm -rf*": "ask",
      "rm -r *": "ask",
      "rm * /": "ask",
      "rmdir *": "ask",
      "chmod -R*": "ask",
      "chown -R*": "ask",
      "sudo *": "ask",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "terraform destroy*": "ask",
      "git checkout main": "deny",
      "git checkout master": "deny",
      "git switch main": "deny",
      "git switch master": "deny",
      "git merge * main": "deny",
      "git merge * master": "deny",
      "git rebase * main": "deny",
      "git rebase * master": "deny",
      "git commit * main": "deny",
      "git commit * master": "deny",
      "git push * main": "deny",
      "git push * master": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git reflog expire*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git commit --amend*": "deny",
      "git branch -D*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/kubeconfig": "deny",
      "**/.kube/config": "deny",
      "**/terraform.tfstate": "deny",
      "**/.terraform/*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "**/.env": "deny",
      "**/kubeconfig": "deny",
      "**/.kube/config": "deny",
      "**/terraform.tfstate": "deny"
    },
    "skill": {
      "chezmoi-expert": "allow"
    }
  }
}
