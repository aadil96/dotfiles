#!/bin/bash
# brew hash: {{ include "dot_config/brew/Brewfile" | sha256sum }}

# Install Homebrew packages with brew bundle. Every Brewfile entry is
# macOS-guarded (see dot_config/brew/Brewfile), but `brew bundle` resolves taps
# and casks *before* applying the per-line `if: OS.mac?` guards, so on non-macOS
# it fails (e.g. "Refusing to load cask ... from untrusted tap") instead of
# installing nothing. Skip non-macOS entirely. Detection is runtime-only
# (uname -s, command -v, then known install locations) — never lookPath baked in
# at template render time.
set -euo pipefail

log() { printf '[portable-install] %s\n' "$*"; }

if [ "$(uname -s 2>/dev/null || true)" != "Darwin" ]; then
  log "EXCLUDED: brew bundle is macOS-only (every Brewfile entry is OS.mac?-guarded)"
  exit 0
fi

BREW="$(command -v brew 2>/dev/null || true)"
if [ -z "$BREW" ]; then
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [ -x "$candidate" ]; then
      BREW="$candidate"
      break
    fi
  done
fi

if [ -z "$BREW" ]; then
  log "EXCLUDED: Homebrew (not installed)"
  exit 0
fi

# Brewfile lives at chezmoi's fixed dot_config mapping ($HOME/.config/brew/),
# NOT under XDG_CONFIG_HOME — chezmoi maps source `dot_config/**` to
# $HOME/.config regardless of XDG. Using the XDG-derived path here would miss
# the applied Brewfile on machines with a custom XDG_CONFIG_HOME.
BREWFILE="$HOME/.config/brew/Brewfile"
if ! "$BREW" bundle --file "$BREWFILE"; then
  log "ERROR: brew bundle failed. Retry manually:"
  log "  $BREW bundle --file \"$BREWFILE\""
  exit 1
fi
log "brew bundle complete"